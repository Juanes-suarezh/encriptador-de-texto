        <!-- Notación relacional -->
        <mxCell id="notacion" value="Notación del modelo relacional&#xa;&#xa;CINE (id_cine, nombre, calle, numero, telefono, ubicacion)&#xa;SALA (id_sala, id_cine*, numero_sala, capacidad)&#xa;PRECIO (id_precio, id_cine*, tipo_dia, valor)&#xa;PELICULA (id_pelicula, titulo, director, genero, clasificacion)&#xa;PROTAGONISTA (id_protagonista, nombre)&#xa;ACTUA_EN (id_pelicula*, id_protagonista*)   ← PK compuesta&#xa;PROYECCION (id_proyeccion, id_sala*, id_pelicula*, hora, dias_horario, horario_venta)&#xa;&#xa;* = clave foránea   |   subrayado implícito en PK&#xa;UNIQUE (id_cine, tipo_dia) en PRECIO&#xa;UNIQUE (id_sala, id_pelicula, hora, dias_horario) en PROYECCION" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="740" height="280" as="geometry" />
        </mxCell>

        <mxCell id="ejemplo" value="Ejemplo del enunciado (mapeo)&#xa;&#xa;CINE: SUBA | Av Cali con Av Suba | Tel 3950592&#xa;      ubicacion = Centro Comercial Plaza Imperial&#xa;&#xa;PROYECCION:&#xa;• Rápidos y furiosos — 15:50 — todos los días&#xa;• Gatotopia — 15:50 — Lu a Vi&#xa;• Space Jam — 18:50 — Domingos y festivos&#xa;• Space Jam — 17:50 — demás días&#xa;&#xa;genero = 'dibujos animados' permite&#xa;consultar películas de animación y dónde se proyectan." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="520" width="400" height="280" as="geometry" />
        </mxCell>

        <mxCell id="leyenda-rel" value="Leyenda&#xa;PK = Primary Key (subrayado)&#xa;FK = Foreign Key (naranja)&#xa;Azul = entidades base&#xa;Verde = película / actores&#xa;Violeta = tablas de relación / N:M" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
