        <mxCell id="t-cli-1" value="PK  num_cliente       INTEGER" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontStyle=4;" vertex="1" parent="t-cli">
