        <mxCell id="t-cli-4" value="     descuento         DECIMAL(5,2)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;" vertex="1" parent="t-cli">
          <mxGeometry y="120" width="280" height="30" as="geometry" />
