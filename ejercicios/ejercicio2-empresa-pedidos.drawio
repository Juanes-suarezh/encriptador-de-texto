        <!-- Notación textual -->
        <mxCell id="notacion" value="Notación del modelo relacional&#xa;&#xa;CLIENTE (num_cliente, saldo, limite_credito, descuento)&#xa;DIRECCION_ENVIO (id_direccion, num_cliente*, numero, calle, comuna, ciudad)&#xa;PEDIDO (num_pedido, num_cliente*, id_direccion*, fecha_pedido)&#xa;LINEA_PEDIDO (num_pedido*, num_linea, num_articulo*, cantidad)&#xa;ARTICULO (num_articulo, descripcion)&#xa;FABRICA (num_fabrica, telefono)&#xa;DISTRIBUYE (num_articulo*, num_fabrica*, existencias)&#xa;FABRICA_ALTERNATIVA (num_fabrica*, num_fabrica_alternativa*)&#xa;&#xa;* = FK&#xa;total_articulos = COUNT(*) FROM DISTRIBUYE WHERE num_fabrica = ?&#xa;CONSTRAINT: limite_credito ≤ 3.000.000&#xa;CONSTRAINT: id_direccion del pedido debe pertenecer al mismo num_cliente" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="720" height="320" as="geometry" />
        </mxCell>

        <mxCell id="leyenda-rel" value="Leyenda&#xa;PK = Primary Key&#xa;FK = Foreign Key (naranja)&#xa;Azul = clientes / pedidos&#xa;Verde = artículos / fábricas&#xa;Violeta = tablas N:M o cuerpo&#xa;Rojo = restricción / derivado" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="620" width="240" height="160" as="geometry" />
        </mxCell>

        <mxCell id="mapeo" value="Correspondencia pedido&#xa;&#xa;Cabecera → PEDIDO&#xa;  • num_cliente&#xa;  • id_direccion (de envío)&#xa;  • fecha_pedido (con hora)&#xa;&#xa;Cuerpo → LINEA_PEDIDO (N líneas)&#xa;  • num_articulo&#xa;  • cantidad" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
