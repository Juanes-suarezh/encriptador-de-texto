        <mxCell id="title" value="DER (Chen) — relleno correcto y atributos en óvalos" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#1B4D3E;fontFamily=Times New Roman;" vertex="1" parent="1">
